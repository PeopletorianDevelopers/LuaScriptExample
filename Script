ReplicatedStorage.changeSetting.OnServerInvoke = function(plr, settingName, variable)
	local setting = plr.stats:FindFirstChild(settingName)
	
	if setting and isSetting[settingName] then
		setting.Value = variable
		return true
	else
		return false
	end
end

ReplicatedStorage.join.OnServerInvoke = function(plr, joinStatus)
	if joinStatus == "join" and plr:HasTag("menu") then
		plr:RemoveTag("menu")
		plr:LoadCharacterAsync()
		return true
	elseif joinStatus == "leave" and not plr:HasTag("menu") then
		plr:AddTag("menu")
		plr.score.Value = 0
		plr.hits.Value = 0
		if plr.Character then
			plr.Character:Destroy()
		end
		return true
	end
end

ReplicatedStorage.buy.OnServerInvoke = function(plr, productId)
	if productId == 3611110067 or productId == 3611110229 or productId == 3611206151 then
		marketplaceService:PromptProductPurchase(plr, productId)
		plr:AddTag("unfinished")
		
		repeat wait() until not plr:HasTag("unfinished")
		
		if plr:HasTag("buy") then
			plr:RemoveTag("buy")
			return true
		else
			return false
		end
	end
end

ReplicatedStorage.shop.OnServerInvoke = function(plr, item)
	if hasItem(plr, item) then
		equipItem(plr, item)
		return "equipped"
	else
		local cost = item:GetAttribute("cost")

		if plr.stats.cash.Value >= cost and not item:HasTag("unbuyable") then
			plr.stats.cash.Value -= cost

			return buyItem(plr, item)
		else
			if item:HasTag("unbuyable") then
				return "no"
			else
				return "poor"
			end
		end
	end
end

marketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, isPurchased)
	local plr = nil

	for i, v in pairs(game.Players:GetPlayers()) do
		if v.UserId == userId then
			plr = v
			break
		end
	end

	if not plr then
		return
	end
	
	plr:RemoveTag("unfinished")
	if isPurchased then
		plr:AddTag("buy")
		if productId == 3611110067 then
			plr.stats.cash.Value += 500
		elseif productId == 3611110229 then
			plr.stats.cash.Value += 1000
		elseif productId == 3611206151 then
			plr.stats.cash.Value += 2500
		end
	end
end)
